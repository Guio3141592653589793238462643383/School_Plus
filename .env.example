# Copiar a .env y ajustar. El .env NO se versiona (está en .gitignore).
# La aplicación lo lee sola al arrancar (DotenvEnvironmentPostProcessor); una variable de
# entorno real del sistema operativo siempre gana sobre este archivo.

# ── Base de datos (MySQL 8 o MariaDB 10.4+ instalado localmente) ─────────────
DB_URL=jdbc:mysql://localhost:3306/school_plus?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Bogota&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=
# El dialecto por defecto es MariaDB. Con MySQL 8 descomentar:
# JPA_DIALECT=org.hibernate.dialect.MySQLDialect

# ── Aplicación ───────────────────────────────────────────────────────────────
SERVER_PORT=8080
# URL con la que se abre la aplicación. Se usa en los enlaces de los correos y en el
# origen permitido del WebSocket.
APP_BASE_URL=http://localhost:8080
# true solo cuando se sirve por HTTPS. Marca la cookie de sesión como Secure.
COOKIE_SECURE=false
SESSION_TIMEOUT=8h

# ── Seguridad ────────────────────────────────────────────────────────────────
# OBLIGATORIA: firma los tokens de "mantener sesión activa". Este valor sirve SOLO para
# desarrollo local; en cualquier otro entorno generar uno propio:
#   openssl rand -base64 48
REMEMBER_ME_KEY=clave-solo-para-desarrollo-local-cambiala-en-otros-entornos

BCRYPT_STRENGTH=12
PASSWORD_MIN_LENGTH=10
RESET_TOKEN_MINUTES=30

# Límite de intentos. Cuenta filas de auditoria_acceso dentro de la ventana.
LOGIN_MAX_POR_CUENTA=5
LOGIN_MAX_POR_IP=20
LOGIN_VENTANA_MINUTOS=15
RESET_MAX_POR_CUENTA=3
RESET_MAX_POR_IP=10
RESET_VENTANA_MINUTOS=60

# ── Cuenta inicial ───────────────────────────────────────────────────────────
# Solo se crea si la base no tiene ningún ADMIN. Después del primer arranque se puede
# dejar BOOTSTRAP_ADMIN_PASSWORD vacío.
BOOTSTRAP_ADMIN_NOMBRE=Administrador School_Plus
BOOTSTRAP_ADMIN_EMAIL=admin@schoolplus.example
BOOTSTRAP_ADMIN_PASSWORD=
# true crea supervisor@, coordinador@ y colaborador@ (mismo dominio y contraseña que el
# ADMIN) para probar los roles. NUNCA en producción.
BOOTSTRAP_DEMO_USUARIOS=false

# ── Correo ───────────────────────────────────────────────────────────────────
# Apagado: el registro y la recuperación de contraseña muestran el enlace en pantalla.
# Para enviar de verdad, una cuenta SMTP propia (con Gmail, un App Password).
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=School_Plus

# ── Archivos subidos ─────────────────────────────────────────────────────────
# Carpeta local donde se guardan documentos, videos y soportes. Relativa al directorio
# desde el que se arranca la aplicación. Nunca se sirve como estática.
STORAGE_PATH=./uploads
MAX_FILE_SIZE=300MB
MAX_REQUEST_SIZE=320MB

# ── Asistencia con QR ────────────────────────────────────────────────────────
# Firma los QR y los códigos. Sin ella se genera una aleatoria en cada arranque.
#   openssl rand -base64 48
ASISTENCIA_TOKEN_KEY=clave-solo-para-desarrollo-local-cambiala-en-otros-entornos
ASISTENCIA_ROTACION_SEGUNDOS=15
ASISTENCIA_TOLERANCIA_MINUTOS=10
ASISTENCIA_DURACION_MAXIMA_HORAS=4
# Validación por ubicación: opcional y apagada por defecto.
ASISTENCIA_GEO_HABILITADA=false
ASISTENCIA_GEO_LATITUD=0
ASISTENCIA_GEO_LONGITUD=0
ASISTENCIA_GEO_RADIO_METROS=300

# Al probar desde celulares con un túnel HTTPS, poner aquí la URL del túnel (también en
# APP_BASE_URL) y cambiar FORWARD_HEADERS_STRATEGY a framework.
FORWARD_HEADERS_STRATEGY=none
